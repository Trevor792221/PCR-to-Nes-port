+def state(s):
+    cars, cur = [], 0
+    for slot in range(8):
+        b = SV_CARS + slot * 32
+        if s.wram(b) == 0xFF:
+            continue
+        if slot == s.wram(0x600D):
+            cur = len(cars)
+        cars.append((s.wram(b), [s.wram(b + 1 + i) for i in range(12)], s.wram(b + 13)))
+    return cars, cur
